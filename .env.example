# Finance Trends & Alarms - configuration (reads mail read-only; never acts on cards or moves money)

# --- Database (PostgreSQL) ---
# Used when running the CLI on the host. Under docker compose, the containers ignore this and use db:5432.
# Port 5433 = the compose database as published on the host; use 5432 for your own local Postgres.
FRAUDALERT_DATABASE_URL=postgresql+psycopg://fraudalert:fraudalert@localhost:5433/fraudalert
# Host ports docker compose publishes (change if something else already uses them)
FRAUDALERT_DB_HOST_PORT=5433
FRAUDALERT_WEB_HOST_PORT=8000

# --- Inbox (IMAP). For Gmail: enable 2FA and create an App Password. ---
FRAUDALERT_IMAP_HOST=imap.gmail.com
FRAUDALERT_IMAP_PORT=993
FRAUDALERT_IMAP_USER=you@gmail.com
FRAUDALERT_IMAP_PASSWORD=your-app-password
FRAUDALERT_IMAP_FOLDER=INBOX
# Only look at mail from these senders (comma separated, substring match on From header)
FRAUDALERT_SENDER_FILTER=no.reply.alerts@chase.com
# Only look at mail whose subject contains one of these (comma separated, optional)
FRAUDALERT_SUBJECT_FILTER=
# Monthly bank statements (PDF attachments): sender(s), optional subject keywords, and the PDF password if
# your bank encrypts them. Only the totals are kept. BAC: estadodecuenta@baccredomatic.cr
FRAUDALERT_STATEMENT_SENDER_FILTER=
FRAUDALERT_STATEMENT_SUBJECT_FILTER=
FRAUDALERT_STATEMENT_PASSWORD=
FRAUDALERT_STATEMENT_SYNC_HOURS=24        # how often to check for statements
# OTP requests: emails with a one-time code to confirm a purchase. One you didn't ask for means someone is
# using your card, so each raises a Critical (priority 0) alarm and a webhook notification. Identify them by
# subject keywords and/or sender (both must match when both are set; comma separated, case-insensitive).
# Senders here are fetched even when not in FRAUDALERT_SENDER_FILTER. Leave both empty to turn this off.
# BAC Costa Rica sends them from notificacionesotp_cri@baccredomatic.com, so the sender alone is enough:
#   FRAUDALERT_OTP_SENDER_FILTER=notificacionesotp_cri@baccredomatic.com
FRAUDALERT_OTP_SUBJECT_FILTER=
FRAUDALERT_OTP_SENDER_FILTER=
# How far back to look on the first sync
FRAUDALERT_LOOKBACK_DAYS=90

# --- Daily report email (time, recipient and bank phone are set on the Settings page) ---
# Blank user/password = send with the IMAP login above (works with a Gmail app password).
FRAUDALERT_SMTP_HOST=smtp.gmail.com
FRAUDALERT_SMTP_PORT=587
FRAUDALERT_SMTP_USER=
FRAUDALERT_SMTP_PASSWORD=

# --- Behaviour ---
# Rules ("amount > 100") and anomaly scores compare amounts in this currency; others are converted
# with approximate built-in rates. Override/add rates as "CODE=value in home currency", e.g. CRC=0.00195
FRAUDALERT_HOME_CURRENCY=USD
FRAUDALERT_FX_RATES=
# Currencies you normally pay in; any other currency counts as foreign. Defaults to the home currency.
# Also editable on the web UI's Settings page (the UI value wins once saved). Example: CRC,USD
FRAUDALERT_NORMAL_CURRENCIES=
# Your country, as your bank writes it (comma-separate spellings). When an alert names the country,
# purchases elsewhere count as foreign.
FRAUDALERT_HOME_COUNTRY=
# Your name as the bank writes it on SINPE transfer notifications (comma-separate spellings). Transfers TO
# this name are money in (or between your own accounts) and aren't counted as spending. Matched by words,
# so a short form like "MARIA LOPEZ" is enough. Empty = every transfer notification is money you sent.
FRAUDALERT_ACCOUNT_HOLDER=
# Card-test detection: an amount at or below this (home currency) is a likely card test (High alarm), and a
# larger charge on the same card within this many hours is escalated too.
FRAUDALERT_TEST_AMOUNT_MAX=1.0
FRAUDALERT_TEST_FOLLOWUP_HOURS=48
# Your local timezone: dates in alert emails are read as this time, and it drives hour-of-day rules.
FRAUDALERT_TIMEZONE=America/New_York
# Anomaly model: "iforest" = Isolation Forest trained on your own history (retrained nightly by the
# worker; uses the statistical "baseline" until there are 50 transactions), or "baseline" only.
FRAUDALERT_DETECTOR=iforest
# Optional: POST a JSON payload here whenever a transaction is flagged (Slack/ntfy/Discord/etc.)
FRAUDALERT_NOTIFY_WEBHOOK_URL=

# --- Web UI access ---
# 127.0.0.1 = this machine only. 0.0.0.0 = any computer on your network (docker compose),
# which requires the username/password below; the app won't start without them.
FRAUDALERT_WEB_BIND=127.0.0.1
FRAUDALERT_WEB_USERNAME=
FRAUDALERT_WEB_PASSWORD=
